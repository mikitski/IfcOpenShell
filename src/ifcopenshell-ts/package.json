{
	"name": "ifcopenshell",
	"version": "0.9.0-alpha0",
	"description": "TypeScript port of ifcopenshell-python, running on a native Node.js binding onto the IfcOpenShell C++ core.",
	"license": "LGPL-3.0-or-later",
	"type": "commonjs",
	"main": "./dist/cjs/index.js",
	"types": "./dist/cjs/index.d.ts",
	"exports": {
		".": {
			"import": "./esm/index.mjs",
			"require": "./dist/cjs/index.js",
			"types": "./dist/cjs/index.d.ts"
		}
	},
	"files": ["dist", "esm", "native/build/Release/*.node"],
	"scripts": {
		"build:native": "cmake-js compile --directory native",
		"build:ts": "tsc -p tsconfig.json",
		"build": "npm run build:native && npm run build:ts",
		"test": "vitest run",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^22.10.2",
		"cmake-js": "^8.0.0",
		"node-addon-api": "^8.9.2",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	}
}
